        <li>Passenger communications: {% if train.variable_train.passenger_communications.free_wifi %}Free WiFi {% endif %}{% if train.variable_train.passenger_communications.wifi %}WiFi {% endif %}{% if train.variable_train.passenger_communications.mains_sockets %}Mains sockets {% endif %}{% if train.variable_train.passenger_communications.telephone %}Telephone {% endif %}{% if train.variable_train.passenger_communications.radio %}Radio {% endif %}{% if train.variable_train.passenger_communications.video %}Video {% endif %}{% if train.variable_train.passenger_communications.business %}Business facilities {% endif %}{% if train.variable_train.passenger_communications.internet %}Internet {% endif %}{% if train.variable_train.passenger_communications.post_office %}Post office {% endif %}{% if train.variable_train.passenger_communications.postbox %}Postbox {% endif %}{% if train.variable_train.passenger_communications.usb_a %}USB-A {% endif %}{% if train.variable_train.passenger_communications.usb_c %}USB-C {% endif %}{% if train.variable_train.passenger_communications.other %}Other {% endif %}</li>
        {% endif %}
