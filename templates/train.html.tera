            <li>Special seating classes: {% if location.change_en_route.accommodation.unknown.special_seating %}  {% endif %}{% if location.change_en_route.accommodation.first_premium.special_seating %} 1+ {% endif %}{% if location.change_en_route.accommodation.first.special_seating %} 1 {% endif %}{% if location.change_en_route.accommodation.second_premium.special_seating %} 2+ {% endif %}{% if location.change_en_route.accommodation.second.special_seating %} 2 {% endif %}{% if location.change_en_route.accommodation.third.special_seating %} 3 {% endif %}</li>
            {% endif %}
