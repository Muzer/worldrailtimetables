        {% endif %}
        {% if train.variable_train.luggage %}
        <li>Luggage: {% if train.variable_train.luggage.bag_storage %}Bag storage {% endif %}{% if train.variable_train.luggage.racks %}Luggage Racks {% endif %}{% if train.variable_train.luggage.skis %}Skis {% endif %}{% if train.variable_train.luggage.bag_storage %}Skis on rear {% endif %}{% if train.variable_train.luggage.extra_large_racks %}Extra large luggage racks {% endif %}{% if train.variable_train.luggage.van %}Luggage van {% endif %}{% if train.variable_train.luggage.bicycles %}Bicycles allowed {% elif train.variable_train.luggage.bicycles == false %}Bicycles not allowed{% endif %}{% if train.variable_train.luggage.bicycles_in_van %}Bicycles in luggage van {% endif %}{% if train.variable_train.luggage.bicycles_in_carriage %}Bicycles in carriage {% endif %}{% if train.variable_train.luggage.pushchairs %}Pushchairs {% endif %}{% if train.variable_train.luggage.vehicles %}Vehicles {% endif %}</li>
        {% endif %}
