        <li>Brand: {{ train.variable_train.brand }}</li>
        {% endif %}
        {% if train.variable_train.name %}
        <li>Name: {{ train.variable_train.name }}</li>
        {% endif %}
        {% if train.variable_train.line %}
        <li> Line: {% if train.variable_train.line.background_colour and train.variable_train.line.foreground_colour %}<span style="background-color: #{{ train.variable_train.line.background_colour }}; color: #{{ train.variable_train.line.foreground_colour }};">{% endif %}{% if train.variable_train.line.url %}<a href="{{ train.variable_train.line.url }}">{% endif %}{% if train.variable_train.line.public_id %}{{ train.variable_train.line.public_id }}{% elif train.variable_train.line.number %}{{ train.variable_train.line.number }}{% endif %}{% if train.variable_train.line.url %}</a>{% endif %}{% if train.variable_train.line.background_colour or train.variable_train.line.foreground_colour %}</span>{% endif %} (Internal ID: {{ train.variable_train.line.id }}) {% if train.variable_train.line.name %}Name: {{ train.variable_train.line.name }} {% endif %}{% if train.variable_train.line.number and train.variable_train.line_public_id %}Number: {{ train.variable_train.line.number }} {% endif %}{% if train.variable_train.line.description %}Description: {{ train.variable_train.line.description }}{% endif %}</li>
        {% endif %}
