            {% endif %}
            {% if location.change_en_route.timing_speed_m_per_s %}
            <li>Timing speed: {{ location.change_en_route.timing_speed_m_per_s }}m/s</li>
            {% endif %}
            {% if location.change_en_route.operating_characteristics %}
            <li>Operating characteristics: {% if location.change_en_route.operating_characteristics.vacuum_braked %}Vacuum braked. {% endif %}{% if location.change_en_route.operating_characteristics.one_hundred_mph %}100mph capable stock. {% endif %}{% if location.change_en_route.operating_characteristics.driver_only_passenger %}Driver only-operated passenger train. {% endif %}{% if location.change_en_route.operating_characteristics.br_mark_four_coaches %}Hauls British Rail Mk 4 coaches. {% endif %}{% if location.change_en_route.operating_characteristics.guard_required %}Requires a guard. {% endif %}{% if location.change_en_route.operating_characteristics.one_hundred_and_ten_mph %}110mph capable stock. {% endif %}{% if location.change_en_route.operating_characteristics.push_pull %}Push-pull. {% endif %}{% if location.change_en_route.operating_characteristics.air_conditioned_with_pa %}Air-conditioned with public address system. {% endif %}{% if location.change_en_route.operating_characteristics.steam_heat %}Steam heated. {% endif %}{% if location.change_en_route.operating_characteristics.runs_to_locations_as_required %}Runs to certain locations as required. {% endif %}{% if location.change_en_route.operating_characteristics.sb1c_gauge %}Conveys SB1C gauge wagons. {% endif %}</li>
            {% endif %}
            {% if location.change_en_route.accommodation.unknown.standing or location.change_en_route.accommodation.first_premium.standing or location.change_en_route.accommodation.first.standing or location.change_en_route.accommodation.second_premium.standing or location.change_en_route.accommodation.second.standing or location.change_en_route.accommodation.third.standing %}
            <li>Standing classes: {% if location.change_en_route.accommodation.unknown.standing %}  {% endif %}{% if location.change_en_route.accommodation.first_premium.standing %} 1+ {% endif %}{% if location.change_en_route.accommodation.first.standing %} 1 {% endif %}{% if location.change_en_route.accommodation.second_premium.standing %} 2+ {% endif %}{% if location.change_en_route.accommodation.second.standing %} 2 {% endif %}{% if location.change_en_route.accommodation.third.standing %} 3 {% endif %}</li>
            {% endif %}
            {% if location.change_en_route.accommodation.unknown.seating or location.change_en_route.accommodation.first_premium.seating or location.change_en_route.accommodation.first.seating or location.change_en_route.accommodation.second_premium.seating or location.change_en_route.accommodation.second.seating or location.change_en_route.accommodation.third.seating %}
            <li>Seating classes: {% if location.change_en_route.accommodation.unknown.seating %}  {% endif %}{% if location.change_en_route.accommodation.first_premium.seating %} 1+ {% endif %}{% if location.change_en_route.accommodation.first.seating %} 1 {% endif %}{% if location.change_en_route.accommodation.second_premium.seating %} 2+ {% endif %}{% if location.change_en_route.accommodation.second.seating %} 2 {% endif %}{% if location.change_en_route.accommodation.third.seating %} 3 {% endif %}</li>
            {% endif %}
            {% if location.change_en_route.accommodation.unknown.reclining_seating or location.change_en_route.accommodation.first_premium.reclining_seating or location.change_en_route.accommodation.first.reclining_seating or location.change_en_route.accommodation.second_premium.reclining_seating or location.change_en_route.accommodation.second.reclining_seating or location.change_en_route.accommodation.third.reclining_seating %}
