        <li>UIC code: {{ train.variable_train.uic_code }}</li>
        {% endif %}
        {% if train.variable_train.operator %}
        <li>Operator: {{ train.variable_train.operator.id }}{% if train.variable_train.operator.public_id %} (public ID: {{ train.variable_train.operator.public_id }}){% endif %}{% if train.variable_train.operator.description %} &mdash; {{ train.variable_train.operator.description }}{% endif %}</li>
        {% endif %}
