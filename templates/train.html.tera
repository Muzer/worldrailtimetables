        {% endif %}
        {% if train.variable_train.carries_vehicles %}
        <li>Carries road vehicles</li>
        {% endif %}
        {% if train.variable_train.reservations %}
        <li>Reservations: Seats {{ train.variable_train.reservations.seats }}, Groups {{ train.variable_train.reservations.groups }}, First class {{ train.variable_train.reservations.first_class }}, Second class {{ train.variable_train.reservations.second_class }}, Not every class {{ train.variable_train.reservations.not_every_class }}, Bicycles {{ train.variable_train.reservations.bicycles }}, Sleepers {{ train.variable_train.reservations.sleepers }}, Road Vehicles {{ train.variable_train.reservations.vehicles }}, Wheelchairs {{ train.variable_train.reservations.wheelchairs }}, {% if train.variable_train.reservations.supplement_charged %}Supplement charged{% elif train.variable_train.reservations.supplement_charged == false %}No supplement charged{% endif %}</li>
        {% endif %}
        {% if train.variable_train.catering %}
        <li>Catering: {% if train.variable_train.catering.at_seat_meal %}At seat meal. {% endif %}{% if train.variable_train.catering.bar %}Bar. {% endif %}{% if train.variable_train.catering.bistro %}Bistro. {% endif %}{% if train.variable_train.catering.breakfast_in_coach %}Breakfast served in coach. {% endif %}{% if train.variable_train.catering.buffet %}Buffet service. {% endif %}{% if train.variable_train.catering.coffee_shop %}Coffee shop. {% endif %}{% if train.variable_train.catering.self_service %}Self-service. {% endif %}{% if train.variable_train.catering.trolley %}Trolley. {% endif %}{% if train.variable_train.catering.vending_machine_food %}Vending machine selling food. {% endif %}{% if train.variable_train.catering.vending_machine_drink %}Vending machine selling drink. {% endif %}{% if train.variable_train.catering.mini_bar %}Minibar. {% endif %}{% if train.variable_train.catering.restaurant %}Restaurant car. {% endif %}{% if train.variable_train.catering.first_class_restaurant %}Restaurant for first class passengers. {% endif %}{% if train.variable_train.catering.first_class_meal %}Meal included for first class passengers. {% endif %}{% if train.variable_train.catering.other %}Other. {% endif %}{% if train.variable_train.catering.food_available %}Food available. {% elif train.variable_train.catering.food_available == false %}Food not available. {% endif %}{% if train.variable_train.catering.drink_available %}Drink available. {% elif train.variable_train.catering.drink_available == false %}Drink not available. {% endif %}{% if train.variable_train.catering.hot_food_available %}Hot food available. {% elif train.variable_train.catering.hot_food_available == false %}Hot food not available. {% endif %}{% if train.variable_train.catering.snacks_available %}Snacks available. {% elif train.variable_train.catering.snacks_available == false %}Snacks not available. {% endif %}</li>
        {% endif %}
