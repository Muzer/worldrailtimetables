            {% if location.change_en_route.assistance %}
            <li>Assistance: {% if location.change_en_route.assistance.personal %}Personal {% endif %}{% if location.change_en_route.assistance.boarding %}Boarding {% endif %}{% if location.change_en_route.assistance.wheelchair %}Wheelchair {% endif %}{% if location.change_en_route.assistance.unaccompanied_minor %}Unaccompanied minor {% endif %}{% if location.change_en_route.assistance.use_of_wheelchair %}Use of a wheelchair {% endif %}{% if location.change_en_route.assistance.guard %}Guard {% endif %}{% if location.change_en_route.assistance.information %}Information {% endif %}{% if location.change_en_route.assistance.other %}Other {% endif %}</li>
            {% endif %}
            {% if location.change_en_route.passenger_information %}
            <li>Passenger information: {% if location.change_en_route.passenger_information.next_stop_indication %}Next stop indication {% endif %}{% if location.change_en_route.passenger_information.stop_announcements %}Stop announcements {% endif %}{% if location.change_en_route.passenger_information.information_display %}Information display {% endif %}{% if location.change_en_route.passenger_information.realtime_connections %}Realtime connections {% endif %}{% if location.change_en_route.passenger_information.audible_information %}Audible information {% endif %}{% if location.change_en_route.passenger_information.hearing_impaired_audible_information %}Audible information with hearing-impaired accessibility features {% endif %}{% if location.change_en_route.passenger_information.visible_information %}Visible information {% endif %}{% if location.change_en_route.passenger_information.visually_impaired_visible_information %}Visible information with visually-impaired accessibility features {% endif %}{% if location.change_en_route.large_print_timetable.next_stop_indication %}Large print timetable {% endif %}{% if location.change_en_route.passenger_information.other %}Other {% endif %}</li>
            {% endif %}
          </ul>
        {% endif %}
      {% endfor %}
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
  </body>
</html>
